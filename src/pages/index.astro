---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, treatmentAreas, treatmentResources } from '../data/site';

const basePath = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<BaseLayout>
  <section class="hero" id="inicio" aria-labelledby="hero-title">
    <img
      class="hero-image"
      src={basePath + 'images/consultorio-tatuape.webp'}
      alt=""
      aria-hidden="true"
      width="900"
      height="600"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="container hero-content" data-reveal="up">
      <p class="eyebrow eyebrow-light">Fisioterapia individualizada · Tatuapé, São Paulo</p>
      <h1 id="hero-title">Recupere o movimento. Volte ao que importa.</h1>
      <p class="hero-description">
        Cuidado atento à sua história, às suas necessidades e aos seus objetivos.
      </p>
      <a class="button button-light" href={site.links.whatsapp} target="_blank" rel="noopener noreferrer">
        Agende pelo WhatsApp
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <a class="hero-scroll" href="#sobre">
      <span aria-hidden="true">↓</span>
      Conheça meu trabalho
    </a>
  </section>

  <section class="section about-section" id="sobre" aria-labelledby="about-title">
    <div class="container about-grid">
      <figure class="portrait" data-reveal="left">
        <div class="portrait-frame">
          <img
            src={basePath + 'images/geovana-batista.webp'}
            alt="Dra. Geovana Batista, fisioterapeuta"
            width="666"
            height="1000"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>
          <span class="portrait-caption-name">Dra. Geovana Batista</span>
          <span class="portrait-caption-role">Fisioterapia individualizada</span>
          <span class="portrait-caption-location">Atendimento no Tatuapé, São Paulo</span>
        </figcaption>
      </figure>

      <div class="about-copy" data-reveal="right" style="--reveal-delay: 120ms">
        <p class="eyebrow">Um cuidado que começa por você</p>
        <h2 id="about-title">Fisioterapia para recuperar movimento, função e qualidade de vida.</h2>
        <p class="lead">
          Cada pessoa tem uma história, uma rotina, uma necessidade e um objetivo. É isso que orienta
          o caminho do tratamento.
        </p>
        <p>
          Meu trabalho começa por entender o que está por trás da sua queixa. A partir de uma escuta
          atenta e de uma avaliação individualizada, construímos um plano de cuidado baseado no que
          faz sentido para você.
        </p>
        <p>
          Atuo principalmente com fisioterapia ortopédica, traumato-ortopédica e esportiva. Meu
          objetivo é ajudar você a recuperar função, confiança no movimento e autonomia para retomar
          as atividades importantes da sua vida.
        </p>
        <a class="text-link" href="#atendimento">
          Conheça minha forma de atender <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section approach-section" id="atendimento" aria-labelledby="approach-title">
    <div class="container">
      <div class="section-heading" data-reveal="up">
        <p class="eyebrow">Atendimento</p>
        <h2 id="approach-title">Um plano pensado para a sua vida.</h2>
        <p>
          O tratamento reúne escuta, avaliação e recursos escolhidos de acordo com cada necessidade.
        </p>
      </div>

      <div class="approach-grid">
        <article class="approach-card" data-reveal="up">
          <span class="card-number" aria-hidden="true">01</span>
          <h3>Escuta e avaliação</h3>
          <p>
            Compreender sua queixa, sua rotina e o que você gostaria de voltar a fazer orienta cada
            etapa do cuidado.
          </p>
        </article>
        <article class="approach-card" data-reveal="up" style="--reveal-delay: 110ms">
          <span class="card-number" aria-hidden="true">02</span>
          <h3>Plano individualizado</h3>
          <p>
            Cada plano é construído de acordo com suas necessidades e revisto conforme sua evolução.
          </p>
        </article>
        <article class="approach-card" data-reveal="up" style="--reveal-delay: 220ms">
          <span class="card-number" aria-hidden="true">03</span>
          <h3>Movimento com confiança</h3>
          <p>
            O objetivo é apoiar sua função e autonomia para que você retome suas atividades com mais
            segurança.
          </p>
        </article>
      </div>

      <div class="treatment-details">
        <div data-reveal="left">
          <h3>Áreas de atuação</h3>
          <ul class="tag-list">
            {treatmentAreas.map((area) => <li>{area}</li>)}
          </ul>
        </div>
        <div data-reveal="right" style="--reveal-delay: 120ms">
          <h3>Recursos terapêuticos</h3>
          <ul class="tag-list">
            {treatmentResources.map((resource) => <li>{resource}</li>)}
          </ul>
        </div>
      </div>

      <aside class="appointment-banner" aria-label="Agendamento pelo WhatsApp" data-reveal="zoom">
        <div>
          <p class="eyebrow eyebrow-light">Próximo passo</p>
          <h3>Vamos conversar sobre seus objetivos?</h3>
          <p>Fale comigo pelo WhatsApp para combinar seu atendimento.</p>
        </div>
        <a class="button button-light" href={site.links.whatsapp} target="_blank" rel="noopener noreferrer">
          Agendar pelo WhatsApp <span aria-hidden="true">↗</span>
        </a>
      </aside>
    </div>
  </section>

  <section class="section location-section" id="localizacao" aria-labelledby="location-title">
    <div class="container location-grid">
      <div class="location-copy" data-reveal="left">
        <p class="eyebrow">Onde atender</p>
        <h2 id="location-title">Unidade Tatuapé</h2>
        <p>Atendimento em consultório na zona leste de São Paulo.</p>
        <address>
          <strong>{site.address.unit}</strong>
          <span>{site.address.streetAddress}</span>
          <span>{site.address.neighborhood}</span>
          <span>{site.address.city}/{site.address.region} · {site.address.postalCode}</span>
        </address>
        <a class="button button-outline" href={site.links.directions} target="_blank" rel="noopener noreferrer">
          Ver rota no Google Maps <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="location-photo" data-reveal="right" style="--reveal-delay: 120ms">
        <img
          src={basePath + 'images/consultorio-tatuape.webp'}
          alt="Ambiente da unidade de atendimento no Tatuapé"
          width="900"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <span class="location-photo-label">Tatuapé · São Paulo</span>
      </div>
    </div>
  </section>

  <section class="section updates-section" id="novidades" aria-labelledby="updates-title">
    <div class="container">
      <div class="section-heading section-heading-inline" data-reveal="up">
        <div>
          <p class="eyebrow">Novidades</p>
          <h2 id="updates-title">Acompanhe as publicações.</h2>
        </div>
        <p>Veja as atualizações compartilhadas pela Dra. Geovana no Instagram.</p>
      </div>
      <div class="updates-grid">
        {site.socialPosts.map((post, index) => (
          <article
            class="update-card"
            data-reveal="up"
            style={'--reveal-delay: ' + index * 140 + 'ms'}
          >
            <span class="update-icon" aria-hidden="true">↗</span>
            <p class="eyebrow">Instagram</p>
            <h3>Publicação da Dra. Geovana Batista</h3>
            <time datetime={post.dateTime}>{post.date}</time>
            <a href={post.url} target="_blank" rel="noopener noreferrer">
              Ver publicação <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section contact-section" id="contato" aria-labelledby="contact-title">
    <div class="container contact-grid">
      <div data-reveal="left">
        <p class="eyebrow eyebrow-light">Contato</p>
        <h2 id="contact-title">Vamos dar o próximo passo?</h2>
        <p>
          Escolha a forma mais prática para tirar dúvidas ou agendar seu atendimento.
        </p>
        <a class="button button-light" href={site.links.whatsapp} target="_blank" rel="noopener noreferrer">
          Agendar pelo WhatsApp <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="contact-details" data-reveal="right" style="--reveal-delay: 120ms">
        <a href={site.links.whatsapp} target="_blank" rel="noopener noreferrer">
          <span class="contact-label">WhatsApp</span>
          <strong>{site.phone}</strong>
        </a>
        <a href={site.phoneLink}>
          <span class="contact-label">Telefone</span>
          <strong>{site.phone}</strong>
        </a>
        <a href={'mailto:' + site.email}>
          <span class="contact-label">E-mail</span>
          <strong>{site.email}</strong>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
